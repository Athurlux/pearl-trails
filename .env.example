# Pearl Trails — environment template. Copy to .env.local and fill in.
# Never commit a file containing real values.

# Neon PostgreSQL connection string (pooled endpoint).
# Console → your project → Connection Details → Connection string.
# Server-only: this must never be exposed to client code or prefixed NEXT_PUBLIC_.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Canonical origin used for metadata (canonical link, OpenGraph, JSON-LD).
# Inlined at build time — set it before `npm run deploy`, not at runtime.
# Defaults to the deployed Workers URL when unset.
# NEXT_PUBLIC_SITE_URL="https://pearl-trails.kranks533.workers.dev"
